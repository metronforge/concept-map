{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/model/**/*.ts", "src/render/**/*.ts"],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": { "high": 80, "low": 60, "break": 0 },
  "concurrency": 2,
  "timeoutMS": 10000,
  "vitest": { "configFile": "vitest.config.ts" }
}
